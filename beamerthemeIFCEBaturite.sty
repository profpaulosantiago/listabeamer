% ============================================================================
% beamerthemeIFCEBaturite.sty
%
% Tema Beamer para listas de exercícios do IFCE Campus Baturité, com
% layouts de título, questão e (futuramente) gabarito. Projetado para
% dupla exibição: projeção e leitura em celular — por isso os tamanhos
% de fonte grandes e absolutos.
%
% -----------------------------------------------------------------------
% Este tema usa coordenadas em cm ABSOLUTOS (não frações de
% \paperwidth/\paperheight), reproduzindo a escala física do PPTX
% original: 33,87 x 19,05 cm (16:9, o tamanho de slide informado pelo
% PowerPoint). O Beamer não aceita "paperwidth"/"paperheight"
% como opção de \documentclass (só entende "aspectratio", que fixa a
% altura em ~9,6cm) — por isso o próprio tema força o tamanho de papel
% correto via o pacote "geometry" logo abaixo. Basta usar:
%
%   \documentclass{beamer}
%   \usetheme{IFCEBaturite}
%
% sem nenhuma opção de papel no \documentclass.
% -----------------------------------------------------------------------
%
% Cores: verde institucional #37A033 (extraído da logomarca) e verde
% claro #E2EFDA (mesmo tom, clareado — accent6 "Mais Claro 80%" do tema
% Office original).
%
% Tipografia (fonte, tamanho em pt, múltiplo de entrelinha -> altura de
% linha em pt, usando a convenção "múltiplo 1 = 1,2x o tamanho da
% fonte", equivalente ao espaçamento "simples" do PowerPoint/Word):
%   Nome do curso (capa, ao lado da logomarca)   Open Sans 16, m.1    -> 19.2pt
%   Demais textos de identificação (capa)        Carlito   24, m.1,15-> 33.12pt
%   Cabeçalho/rodapé das faixas (questão)        Carlito   15, m.1   -> 18pt
%   Número da questão (dentro do crachá)         Carlito   40, m.0,9 -> 43.2pt
%   Título/edição da questão (ao lado do crachá) Carlito   20, m.1,15-> 27.6pt
%   Corpo da questão (colunas de conteúdo)       Carlito   24, m.1,15-> 33.12pt
% ============================================================================

\ProvidesPackage{beamerthemeIFCEBaturite}[2026/10/18 v2.1 Tema IFCE Baturite]

\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{xcolor}
\RequirePackage{ifthen}
\RequirePackage{graphicx}
\RequirePackage{enumitem}
\RequirePackage{array}

% Força o tamanho físico real do slide original (16:9, escala do
% PPTX), sobrescrevendo o tamanho pequeno padrão do Beamer.
\RequirePackage{geometry}
\geometry{paperwidth=33.87cm, paperheight=19.05cm,
          margin=0cm, head=0pt, headsep=0pt, foot=0pt, footskip=0pt}

% Requer compilação com XeLaTeX ou LuaLaTeX (fontspec para Carlito/Open Sans).
\RequirePackage{fontspec}

% --- Fontes ---------------------------------------------------------------
\setmainfont{Carlito}
\setsansfont{Carlito}
\IfFontExistsTF{Open Sans}
  {\newfontfamily\IFCEopensans{Open Sans}}
  {\newfontfamily\IFCEopensans{Carlito}} % fallback silencioso

% --- Cores ------------------------------------------------------------------
\definecolor{ifcegreen}{HTML}{37A033}      % verde institucional (textos)
\definecolor{ifcegreenlight}{HTML}{E2EFDA} % verde claro (faixas de fundo)

\setbeamercolor{normal text}{fg=black,bg=white}
\setbeamercolor{structure}{fg=ifcegreen}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{footline}{}
\setbeamertemplate{headline}{}
\setbeamercolor{background canvas}{bg=white}
\frenchspacing % evita espaço extra depois de abreviações como "Prof."

% --- Tamanhos de fonte absolutos (fonte, entrelinha) -----------------------
% entrelinha = 1.2 * tamanho * múltiplo (ver cabeçalho do arquivo)
\newcommand{\IFCEfontCurso}{\IFCEopensans\fontsize{16}{19.2}\selectfont}      % 16, m.1
\newcommand{\IFCEfontIdentCapa}{\fontsize{24}{33.12}\selectfont}             % 24, m.1,15
\newcommand{\IFCEfontFaixa}{\fontsize{15}{18}\selectfont}                    % 15, m.1
\newcommand{\IFCEfontBadge}{\fontsize{40}{43.2}\selectfont}                  % 40, m.0,9
\newcommand{\IFCEfontTituloQuestao}{\fontsize{20}{27.6}\selectfont}          % 20, m.1,15
\newcommand{\IFCEfontCorpo}{\fontsize{24}{33.12}\selectfont}                 % 24, m.1,15

% --- Contador de questão (avança a cada \question, formato "01","02",...) --
\newcounter{IFCEquestao}
\newcommand{\IFCEnumeroquestao}{\ifnum\value{IFCEquestao}<10 0\fi\arabic{IFCEquestao}}

% --- Separador "quadradinho" (lembra a logomarca do IFCE) -------------------
% Desenhado com \rule (não depende de o glifo existir na fonte) e herda a
% cor do texto em volta.
\newcommand{\IFCEsep}{\,\raisebox{0.15em}{\rule{0.32em}{0.32em}}\,}

% --- Metadados globais (definidos uma vez, reaproveitados em todo slide) ---
\newcommand{\IFCEinstituicao}{}
\newcommand{\IFCEcurso}{}
\newcommand{\IFCEdisciplina}{}
\newcommand{\IFCEtipoConteudo}{}
\newcommand{\IFCEdescricaoConteudo}{}
\newcommand{\IFCEassunto}{}
\newcommand{\IFCEprofessor}{}
\newcommand{\IFCElogoCurso}{} % conteúdo livre (normalmente \includegraphics{caminho})

% Logomarca e ícone institucionais (IFCE Baturité): são os MESMOS em
% toda lista, mas o template não vem com nenhum arquivo de imagem --
% os PDFs/SVGs ficam num diretório externo, fora do repositório do
% template (git não deveria carregar binários repetidos a cada
% clone). Defina o caminho uma vez, no preâmbulo de cada lista, com
% \IFCEativosInstitucionais{...}{...} (veja abaixo).
\newcommand{\IFCElogoInstituicao}{} % conteúdo livre, ex. \includegraphics[width=7.25cm]{caminho}
\newcommand{\IFCEiconeInstituicao}{} % conteúdo livre, ex. \includegraphics[width=0.37cm]{caminho}

% \IFCEativosInstitucionais{logomarca da capa}{ícone minúsculo do rodapé}
\newcommand{\IFCEativosInstitucionais}[2]{%
  \renewcommand{\IFCElogoInstituicao}{#1}%
  \renewcommand{\IFCEiconeInstituicao}{#2}%
}

% \IFCEmetadados{instituição}{curso/turma}{nome da disciplina}%
%               {tipo de conteúdo}{descrição do conteúdo}%
%               {assunto/tópico}{nome do professor}%
%               {logomarca do curso -- conteúdo livre, ex. \includegraphics{...}}
\newcommand{\IFCEmetadados}[8]{%
  \renewcommand{\IFCEinstituicao}{#1}%
  \renewcommand{\IFCEcurso}{#2}%
  \renewcommand{\IFCEdisciplina}{#3}%
  \renewcommand{\IFCEtipoConteudo}{#4}%
  \renewcommand{\IFCEdescricaoConteudo}{#5}%
  \renewcommand{\IFCEassunto}{#6}%
  \renewcommand{\IFCEprofessor}{#7}%
  \renewcommand{\IFCElogoCurso}{#8}%
}

% ============================================================================
% \CapaIFCE{conteúdo à direita}
%
% Slide de título. Todos os textos de identificação vêm de \IFCEmetadados
% (definido antes, uma vez, no preâmbulo) — só a ilustração da capa é
% passada como argumento.
% ============================================================================
\newcommand{\CapaIFCE}[1]{%
\begin{frame}[plain]
\begin{tikzpicture}[remember picture, overlay]
  \coordinate (PO) at (current page.north west);

  % Faixa superior larga (0 a 3,0cm)
  \fill[ifcegreenlight] (PO) rectangle ($(PO)+(\paperwidth,-3.0cm)$);
  % Faixa inferior (18,35 a 19,05cm) -- mesma cor, presente em todo slide
  \fill[ifcegreenlight] ($(PO)+(0,-18.35cm)$) rectangle ($(PO)+(\paperwidth,-19.05cm)$);

  % Logomarca da instituição -- altura SEMPRE 2,0cm (força via \resizebox,
  % não importa a largura vinda do config.tex), alinhada à esquerda
  \node[anchor=north west, inner sep=0pt] at ($(PO)+(0.5cm,-0.5cm)$)
    {\resizebox{!}{2.0cm}{\IFCElogoInstituicao}};

  % Logomarca do CURSO (varia conforme a lista/curso -- vem de \IFCEmetadados,
  % conteúdo livre; deixe \IFCEplaceholder{...} até ter a arte definitiva) --
  % altura SEMPRE 2,0cm, alinhada à direita, a 0,5cm da margem direita
  \node[anchor=north east, inner sep=0pt] at ($(PO)+(33.37cm,-0.3133cm)$)
    {\resizebox{!}{2.0cm}{\IFCElogoCurso}};

  % Coluna esquerda de metadados (Carlito 24/33.12)
  \node[anchor=north west, text width=14.00cm, align=left,
        font=\color{ifcegreen}\IFCEfontIdentCapa]
        at ($(PO)+(0.5cm,-4.00cm)$) {\IFCEtipoConteudo};
  \node[anchor=north west, text width=14.00cm, align=left,
        font=\bfseries\IFCEfontIdentCapa]
        at ($(PO)+(0.5cm,-5.30cm)$) {\IFCEdescricaoConteudo};
  \node[anchor=north west, text width=14.00cm, align=left,
        font=\color{ifcegreen}\IFCEfontIdentCapa]
        at ($(PO)+(0.5cm,-9.20cm)$) {\IFCEdisciplina};
  \node[anchor=north west, text width=14.00cm, align=left,
        font=\bfseries\IFCEfontIdentCapa]
        at ($(PO)+(0.5cm,-10.50cm)$) {\IFCEassunto};
  \node[anchor=south west, text width=14.00cm, align=left, font=\IFCEfontIdentCapa]
        at ($(PO)+(0.5cm,-17.00cm)$) {\IFCEprofessor};

  % Coluna direita: conteúdo livre (imagem/ilustração da capa),
  % até 0,5cm da margem direita
  \node[anchor=north west, text width=17.87cm, align=left]
        at ($(PO)+(15.50cm,-4.00cm)$) {#1};
\end{tikzpicture}
\end{frame}%
}

% ============================================================================
% Slide de questão -- duas formas:
%
%   \question{título/edição}{conteúdo}
%       USO PADRÃO. O conteúdo é um texto corrido: enche primeiro a coluna
%       esquerda, continua na direita e, se ainda sobrar, abre outro slide
%       sozinho (mesmo número no crachá, título com "[continuação]" e aviso
%       "[continua >]" no slide anterior). O corpo fica SEMPRE em 24 pt --
%       a fonte nunca é reduzida para caber.
%
%   \question*{título/edição}{conteúdo esquerdo}{conteúdo direito}
%       USO MANUAL. Duas caixas independentes: você decide o que vai em cada
%       coluna (ex.: texto à esquerda, figura grande à direita). Nada passa
%       de uma coluna para a outra.
%
% Cabeçalho e rodapé são montados automaticamente a partir dos metadados
% globais. O número do crachá avança sozinho ("01", "02", ...) e sua linha
% de base é a mesma do título ao lado, por construção (ambos ancorados em
% "base"/"base west" na mesma coordenada).
%
% Por que não multicol: o multicol depende do construtor de páginas do TeX,
% que não age dentro de um nó do TikZ de posição e altura fixas -- ele
% equilibraria as colunas e deixaria o excesso vazar sobre o rodapé. Aqui o
% conteúdo é composto numa caixa de 15,75 cm de largura e cortado com \vsplit
% na altura de uma coluna: 1º pedaço -> esquerda, 2º -> direita, resto ->
% próximo slide.
%
% Recuo: no uso padrão, todo parágrafo NOVO começa com recuo de 2,0 cm, em
% qualquer coluna; um parágrafo que continua de uma coluna (ou slide) para a
% seguinte segue sem recuo. No uso manual, vale a regra antiga: recuo de
% 2,0 cm na primeira linha dos parágrafos da coluna esquerda; direita sem
% recuo.
% ============================================================================

% --- desenho do slide (comum às duas formas) --------------------------------
% #1 título, #2 coluna esquerda, #3 coluna direita, #4 aviso à direita do título
\newcommand{\IFCEslideQuestao}[4]{%
\begin{frame}[plain]
\begin{tikzpicture}[remember picture, overlay]
  \coordinate (PO) at (current page.north west);

  % Faixa superior fina (0 a 0,7cm): disciplina + tipo + assunto
  \fill[ifcegreenlight] (PO) rectangle ($(PO)+(\paperwidth,-0.7cm)$);
  \node[anchor=west, font=\color{ifcegreen}\IFCEfontFaixa] at ($(PO)+(0.5cm,-0.35cm)$)
    {\IFCEdisciplina\IFCEsep\IFCEtipoConteudo\IFCEsep\IFCEassunto};

  % Faixa inferior (18,35 a 19,05cm)
  \fill[ifcegreenlight] ($(PO)+(0,-18.35cm)$) rectangle ($(PO)+(\paperwidth,-19.05cm)$);

  % Crachá (fundo verde, cantos arredondados) -- sem texto embutido
  \node[anchor=north west, fill=ifcegreen, rounded corners=3pt,
        minimum width=2.0cm, minimum height=2.0cm, inner sep=0pt]
        at ($(PO)+(0.5cm,-1.2cm)$) {};

  % Número da questão: define a linha de base de referência
  \node[anchor=base, font=\color{white}\bfseries\IFCEfontBadge]
        at ($(PO)+(1.5cm,-2.85cm)$) {\IFCEnumeroquestao};

  % Título/edição da questão -- MESMA linha de base do número acima
  \node[anchor=base west, text width=14.00cm, align=left,
        font=\color{ifcegreen}\IFCEfontTituloQuestao]
        at ($(PO)+(2.5cm,-2.85cm)$) {#1};

  % Aviso à direita do título (ex. "[continua >]"), na mesma linha de base,
  % a 0,5cm da margem direita
  \node[anchor=base east, font=\color{ifcegreen}\IFCEfontTituloQuestao]
        at ($(PO)+(33.37cm,-2.85cm)$) {#4};

  % Coluna esquerda: 15,75 x 14,6cm, canto superior esquerdo em (0,5;3,4)cm
  \node[anchor=north west, text width=15.75cm, align=justify, font=\IFCEfontCorpo]
        at ($(PO)+(0.5cm,-3.40cm)$) {#2};

  % Coluna direita: 15,75 x 14,6cm, canto superior esquerdo em (17,25;3,4)cm
  \node[anchor=north west, text width=15.75cm, align=justify, font=\IFCEfontCorpo]
        at ($(PO)+(17.25cm,-3.40cm)$) {#3};

  % Ícone institucional minúsculo, centralizado dentro da margem de 0,5cm
  \node[anchor=south west, inner sep=0pt] at ($(PO)+(0.0652cm,-18.95cm)$)
    {\IFCEiconeInstituicao};

  % Rodapé esquerdo: instituição / curso / professor
  \node[anchor=west, font=\color{ifcegreen}\IFCEfontFaixa] at ($(PO)+(0.5cm,-18.70cm)$)
    {\IFCEinstituicao\IFCEsep\IFCEcurso\IFCEsep\IFCEprofessor};

  % Rodapé direito: contagem de slides, a 0,5cm da margem direita
  \node[anchor=east, font=\color{ifcegreen}\IFCEfontFaixa] at ($(PO)+(33.37cm,-18.70cm)$)
    {Slide \insertframenumber\ de \inserttotalframenumber};
\end{tikzpicture}
\end{frame}%
}

% --- uso manual: \question*{título}{esquerda}{direita} ----------------------
% (o \indent explícito é necessário porque, dentro de um nó do TikZ, a
% primeira linha do texto normalmente NÃO recebe o recuo automático de
% parágrafo -- só as continuações depois de uma linha em branco.)
\newcommand{\IFCEquestaoManual}[3]{%
  \stepcounter{IFCEquestao}%
  \edef\IFCEnumeroEmMontagem{\the\value{IFCEquestao}}% (para o gabarito)
  \IFCEslideQuestao{#1}{\setlength{\parindent}{2.0cm}\indent#2}{#3}{}}

% --- uso padrão: \question{título}{conteúdo} --------------------------------
\newlength{\IFCEalturaColuna}
\setlength{\IFCEalturaColuna}{14.45cm} % 14,6cm menos uma pequena folga
\newbox\IFCEcorpo
\newbox\IFCEcolunaA
\newbox\IFCEcolunaB
\newif\ifIFCEcontinua
\newif\ifIFCEprimeiroSlide
\newcommand{\IFCEtituloAtual}{}

\newcommand{\IFCEproximoSlide}{%
  \setbox\IFCEcolunaA=\vsplit\IFCEcorpo to \IFCEalturaColuna
  \setbox\IFCEcolunaA=\vbox to \IFCEalturaColuna{\unvbox\IFCEcolunaA\vfill}%
  \setbox\IFCEcolunaB=\vsplit\IFCEcorpo to \IFCEalturaColuna
  \setbox\IFCEcolunaB=\vbox to \IFCEalturaColuna{\unvbox\IFCEcolunaB\vfill}%
  \ifdim\dimexpr\ht\IFCEcorpo+\dp\IFCEcorpo\relax<12pt
    \IFCEcontinuafalse\else\IFCEcontinuatrue\fi
  \ifIFCEprimeiroSlide\else\addtocounter{IFCEquestao}{-1}\fi
  \stepcounter{IFCEquestao}%
  \IFCEslideQuestao
    {\IFCEtituloAtual\ifIFCEprimeiroSlide\else\ [continuação]\fi}
    {\copy\IFCEcolunaA}
    {\copy\IFCEcolunaB}
    {\ifIFCEcontinua[continua $>$]\fi}%
  \ifIFCEcontinua\IFCEprimeiroSlidefalse\expandafter\IFCEproximoSlide\fi}

\newcommand{\IFCEquestaoAuto}[2]{%
  \renewcommand{\IFCEtituloAtual}{#1}%
  \edef\IFCEnumeroEmMontagem{\the\numexpr\value{IFCEquestao}+1\relax}% (para o gabarito)
  \setbox\IFCEcorpo=\vbox{%
    \hsize=15.75cm \linewidth=\hsize
    \leftskip=0pt \rightskip=0pt \parfillskip=0pt plus 1fil % justificado (o Beamer usa \raggedright)
    \parindent=2.0cm \parskip=0pt
    \emergencystretch=8em \tolerance=9999 \splittopskip=0pt
    \IFCEfontCorpo #2\par}%
  \IFCEprimeiroSlidetrue
  \IFCEproximoSlide}

\newcommand{\question}{\@ifstar{\IFCEquestaoManual}{\IFCEquestaoAuto}}

% ============================================================================
% Alternativas e gabarito automático
%
%   \begin{alternativas}
%     \item ...            alternativa comum
%     \itemCorreto ...     alternativa correta (vai para o gabarito)
%     \itemCorreto* ...    correta, mas sem gabarito oficial (sai com * no gabarito)
%   \end{alternativas}
%
%   \gabarito            no fim do documento: monta o(s) slide(s) de gabarito
%                        com "número -- letra" de cada questão, na ordem em que
%                        as questões aparecem. Mudou a ordem das questões, o
%                        gabarito acompanha sozinho (basta compilar de novo).
%
% As letras seguem o formato do exemplo do template: a), b), c), ...
% Questão sem \itemCorreto aparece no gabarito com "?".
% ============================================================================
\newcommand{\IFCEnumeroEmMontagem}{0}
\newif\ifIFCEhaNaoOficial

\newenvironment{alternativas}
  {\par\nobreak\vspace{2mm}\nobreak
   \begin{enumerate}[label=\alph{enumi}), leftmargin=1.4cm,
     labelsep=0.3cm, topsep=0pt, itemsep=1mm, parsep=0pt, beginpenalty=10000]
   \interlinepenalty=10000 \clubpenalty=10000 \widowpenalty=10000}
  {\end{enumerate}}

% grava a letra da alternativa correta da questão que está sendo montada
\newcommand{\IFCEregistraCorreta}[1]{%
  \expandafter\xdef\csname IFCEgab@\IFCEnumeroEmMontagem\endcsname{\alph{enumi}#1}%
  \ifx\relax#1\relax\else\global\IFCEhaNaoOficialtrue\fi}
\newcommand{\itemCorreto}{\@ifstar
  {\item\IFCEregistraCorreta{*}}%
  {\item\IFCEregistraCorreta{}}}

% slide de gabarito: até 70 respostas por slide (7 colunas x 10 linhas)
\newcount\IFCEgabTotal
\newcount\IFCEgabInicio
\newcount\IFCEgabFim
\newcount\IFCEgabLinhas
\newcommand{\IFCEdoisDigitos}[1]{\ifnum#1<10 0\fi\number#1}

\newcommand{\IFCEslideGabarito}{%
\begin{frame}[plain]
\begin{tikzpicture}[remember picture, overlay]
  \coordinate (PO) at (current page.north west);
  \fill[ifcegreenlight] (PO) rectangle ($(PO)+(\paperwidth,-0.7cm)$);
  \node[anchor=west, font=\color{ifcegreen}\IFCEfontFaixa] at ($(PO)+(0.5cm,-0.35cm)$)
    {\IFCEdisciplina\IFCEsep\IFCEtipoConteudo\IFCEsep\IFCEassunto};
  \fill[ifcegreenlight] ($(PO)+(0,-18.35cm)$) rectangle ($(PO)+(\paperwidth,-19.05cm)$);
  \node[anchor=north west, fill=ifcegreen, rounded corners=3pt,
        minimum width=2.0cm, minimum height=2.0cm, inner sep=0pt]
        at ($(PO)+(0.5cm,-1.2cm)$) {};
  \node[anchor=base, font=\color{white}\bfseries\fontsize{30}{33}\selectfont]
        at ($(PO)+(1.5cm,-2.85cm)$) {GAB};
  \node[anchor=base west, font=\color{ifcegreen}\IFCEfontTituloQuestao]
        at ($(PO)+(2.5cm,-2.85cm)$) {Gabarito};
  % respostas: colunas de cima para baixo, da esquerda para a direita
  \pgfmathtruncatemacro{\IFCEgabN}{\IFCEgabFim-\IFCEgabInicio+1}
  \foreach \k in {1,...,\IFCEgabN}{%
    \pgfmathtruncatemacro{\IFCEq}{\IFCEgabInicio+\k-1}
    \pgfmathtruncatemacro{\IFCEcol}{div(\k-1,\IFCEgabLinhas)}
    \pgfmathtruncatemacro{\IFCElin}{mod(\k-1,\IFCEgabLinhas)}
    \node[anchor=base west, font=\IFCEfontCorpo]
      at ($(PO)+(0.5cm+\IFCEcol*4.7cm,-4.6cm-\IFCElin*1.25cm)$)
      {\textbf{\color{ifcegreen}\IFCEdoisDigitos{\IFCEq}}\ --\ %
       \expandafter\ifx\csname IFCEgab@\IFCEq\endcsname\relax ?%
       \else\csname IFCEgab@\IFCEq\endcsname\fi};
  }
  \ifIFCEhaNaoOficial
    \node[anchor=south west, text width=32.87cm, align=left, font=\IFCEfontFaixa]
      at ($(PO)+(0.5cm,-18.1cm)$)
      {* Resposta não oficial: o gabarito oficial não estava disponível.};
  \fi
  \node[anchor=south west, inner sep=0pt] at ($(PO)+(0.0652cm,-18.95cm)$)
    {\IFCEiconeInstituicao};
  \node[anchor=west, font=\color{ifcegreen}\IFCEfontFaixa] at ($(PO)+(0.5cm,-18.70cm)$)
    {\IFCEinstituicao\IFCEsep\IFCEcurso\IFCEsep\IFCEprofessor};
  \node[anchor=east, font=\color{ifcegreen}\IFCEfontFaixa] at ($(PO)+(33.37cm,-18.70cm)$)
    {Slide \insertframenumber\ de \inserttotalframenumber};
\end{tikzpicture}
\end{frame}}

\newcommand{\gabarito}{%
  \IFCEgabTotal=\value{IFCEquestao}\relax
  \IFCEgabInicio=1\relax
  \loop
    \IFCEgabFim=\numexpr\IFCEgabInicio+69\relax
    \ifnum\IFCEgabFim>\IFCEgabTotal \IFCEgabFim=\IFCEgabTotal\fi
    % linhas por coluna: o necessário para caber em 7 colunas (máx. 10)
    \IFCEgabLinhas=\numexpr(\IFCEgabFim-\IFCEgabInicio+7)/7\relax
    \ifnum\IFCEgabLinhas>10 \IFCEgabLinhas=10\fi
    \ifnum\IFCEgabLinhas<1 \IFCEgabLinhas=1\fi
    \IFCEslideGabarito
    \IFCEgabInicio=\numexpr\IFCEgabFim+1\relax
  \ifnum\IFCEgabInicio>\IFCEgabTotal\else\repeat}

% --- Legendas (figure/table): sem rótulo "Figure:", alinhadas à direita ---
\setbeamertemplate{caption}{\raggedleft\insertcaption\par}
\setbeamerfont{caption}{size=\fontsize{11}{18}\selectfont}

% ============================================================================
% \IFCEplaceholder[largura]{legenda}
%
% Caixa tracejada simples para marcar onde entraria uma figura/imagem
% específica de uma questão. O template-base não inclui nenhuma imagem
% de conteúdo, apenas a marca institucional.
%
% (A altura é 0,55x a largura. Isso é calculado com \pgfmathsetlength --
% não com concatenação direta tipo "0.55#1" -- porque quando a largura já
% tem casas decimais (ex. "2.0cm"), a concatenação de texto gera um
% número com dois pontos decimais ("0.552.0cm"), que o TeX não consegue
% interpretar como dimensão válida.)
% ============================================================================
\newlength{\IFCEplaceholderht}
\newlength{\IFCEplaceholderwd}
\newlength{\IFCEplaceholdertw}
\newcommand{\IFCEplaceholder}[2][\linewidth]{%
  \pgfmathsetlength{\IFCEplaceholderwd}{#1}%
  \pgfmathsetlength{\IFCEplaceholderht}{0.55*(#1)}%
